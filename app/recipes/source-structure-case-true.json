{
  "schema_version": 1,
  "name": "SourceStructurecaseTrue",
  "steps": [
    {
      "id": "input",
      "op": "control",
      "args": {
        "style": "Numeric Control",
        "x": 40,
        "y": 40,
        "label": "Input"
      }
    },
    {
      "id": "structure",
      "op": "case",
      "args": {
        "owner_diagram_id": "$root.diagram_id",
        "bounds": [
          550,
          350
        ],
        "x": 240,
        "y": 140,
        "style": "Case Structure"
      }
    },
    {
      "id": "selector",
      "op": "control",
      "args": {
        "style": "Horizontal Toggle Switch",
        "x": 40,
        "y": 120,
        "label": "Selector"
      }
    },
    {
      "id": "special",
      "op": "node_terminals",
      "args": {
        "node_id": "$structure.case_id"
      }
    },
    {
      "id": "selectWire",
      "op": "wire",
      "args": {
        "source_terminal": "$selector.terminal_id",
        "sink_terminal": "$special.pins.0"
      }
    },
    {
      "id": "connect",
      "op": "connect_source_to_structure",
      "args": {
        "source_terminal": "$input.terminal_id",
        "structure_id": "$structure.case_id"
      }
    },
    {
      "id": "out0",
      "op": "typed_indicator",
      "args": {
        "terminal_id": "$connect.inside_ids.0"
      }
    },
    {
      "id": "label0",
      "op": "label",
      "args": {
        "control_id": "$out0.control_id",
        "label": "Echo0"
      }
    },
    {
      "id": "out1",
      "op": "typed_indicator",
      "args": {
        "terminal_id": "$connect.inside_ids.1"
      }
    },
    {
      "id": "label1",
      "op": "label",
      "args": {
        "control_id": "$out1.control_id",
        "label": "Echo1"
      }
    },
    {
      "id": "inputDefault",
      "op": "control_default",
      "args": {
        "control_id": "$input.object_id",
        "value": -3.25
      }
    },
    {
      "id": "selectorDefault",
      "op": "control_default",
      "args": {
        "value": true,
        "control_id": "$selector.object_id"
      }
    }
  ]
}
{
  "schema_version": 1,
  "name": "ForConditionalDemo",
  "steps": [
    {"id":"loop","op":"for","args":{"owner_diagram_id":"$root.diagram_id","style":"For Loop","x":150,"y":100,"bounds":[450,300]}},
    {"id":"enable_stop","op":"for_conditional","args":{"for_id":"$loop.for_id","has_conditional_terminal":true}},
    {"id":"body","op":"for_info","args":{"for_id":"$loop.for_id"}},
    {"id":"ports","op":"for_terminals","args":{"for_id":"$loop.for_id"}},
    {"id":"stop","op":"for_stop","args":{"for_id":"$loop.for_id"}},
    {"id":"count","op":"constant","args":{"terminal_id":"$ports.count_id"}},
    {"id":"ten","op":"set_number","args":{"constant_id":"$count.constant_id","value":10}},
    {"id":"compare","op":"node","args":{"owner_diagram_id":"$body.diagram_id","style":"Equal?","x":260,"y":180}},
    {"id":"counter_compare","op":"wire","args":{"source_terminal":"$ports.counter_id","sink_terminal":"$compare.pins.x"}},
    {"id":"limit","op":"constant","args":{"terminal_id":"$compare.pins.y"}},
    {"id":"two","op":"set_number","args":{"constant_id":"$limit.constant_id","value":2}},
    {"id":"stop_wire","op":"wire","args":{"source_terminal":"$compare.terminal_ids.0","sink_terminal":"$stop.stop_id"}},
    {"id":"out","op":"typed_indicator","args":{"terminal_id":"$ports.counter_id"}},
    {"id":"label","op":"label","args":{"control_id":"$out.control_id","label":"Last iteration"}},
    {"id":"tidy","op":"cleanup","args":{}}
  ]
}
